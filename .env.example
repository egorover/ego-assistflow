# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI / ProxyAPI Configuration
# Для работы через ProxyAPI (без VPN):
OPENAI_API_KEY=your_proxyapi_or_openai_key_here
USE_PROXYAPI=true

# Или для прямого доступа к OpenAI:
# OPENAI_API_KEY=sk-...
# USE_PROXYAPI=false

# Bot Settings
BOT_MODE=text
DEFAULT_VOICE=alloy
LOG_LEVEL=INFO
